{
  "opencollection": "1.0.0",
  "info": {
    "name": "Dixa Agents Organization API",
    "version": "beta"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get organization details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://dev.dixa.io/beta/organization"
          },
          "docs": "Retrieves information about the organization associated with the provided API token"
        }
      ]
    }
  ],
  "bundled": true
}