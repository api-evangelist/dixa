                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"content\": {\n    \"value\": \"<string>\"\n  },\n  \"attachments\": [\n    {\n      \"url\": \"<string>\",\n      \"prettyName\": \"<string>\"\n    },\n    {\n      \"url\": \"<string>\",\n      \"prettyName\": \"<string>\"\n    }\n  ],\n  \"integrationEmail\": \"<string>\",\n  \"externalId\": \"<string>\"\n}",
